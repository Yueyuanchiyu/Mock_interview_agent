APP_NAME=Mock Interview Agent
APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8080
REPORT_BASE_URL=http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=true
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=90

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE=ai_mock_interview

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
FROM_EMAIL=
EMAIL_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120

ENABLE_VECTOR_RAG=true
VECTOR_DB_DIR=vector_db
VECTOR_COLLECTION_NAME=knowledge_base
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
RAG_TOP_K=5

CONTEXT_MAX_TOKENS=5000
ANSWER_MAX_LENGTH=8000
HISTORY_MAX_MESSAGES=30
MAX_FOLLOWUP_DEPTH=3
MAX_TOOL_CALLS=8

AGENT_CHECKPOINT_BACKEND=memory
AGENT_POSTGRES_URL=

